{
  "name": "helix-collective-website",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Helix Collective marketing website rebuild — Astro + React + TypeScript, statically generated.",
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",

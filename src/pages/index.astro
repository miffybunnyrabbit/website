---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import ProofBanner from "../components/ProofBanner.astro";
import LogoMarquee from "../components/LogoMarquee.astro";
import CaseStudies from "../components/CaseStudies.astro";
import WhyHelix from "../components/WhyHelix.astro";
import HowWeWork from "../components/HowWeWork.astro";
import Fit from "../components/Fit.astro";
import FinalCta from "../components/FinalCta.astro";
import Footer from "../components/Footer.astro";
import {
  assertApprovalQueueValid,
  formatOpenQueueWarning,
} from "../config/approvalQueue";
import { assertClaimsLedgerValid } from "../config/claimsLedger";
import { assertAssetRegisterValid } from "../config/assetRegister";
import { assertEngagementModelValid } from "../config/engagementModel";
import { assertConfiguredCtaValid, isCtaConfigured } from "../config/cta";

// Governance gate (§23, P6-002): the queue must be internally consistent and
// must track every content item that still needs sign-off, or the build fails.
// Approval never blocks publication, so the still-open items are only surfaced
// as a non-fatal warning listing what publishes in draft form (§20.1).
assertApprovalQueueValid();
console.warn(formatOpenQueueWarning());

// Claims gate (§17.7 R-006, §20.1): every quantified claim on the site must
// resolve to a ledger entry that is not `rejected`, is backed by an open
// category-B approval item until it clears, and whose queue item actually covers
// it. A dangling or mismatched `claimIds` reference fails the build here.
assertClaimsLedgerValid();

// Asset-rights gate (§17.9 R-008, §8.4, §16.5): every logo and case-study image
// the site can ship must resolve to an asset-register row recording its rights,
// and the removed brands, the Xylo case-study panel, and the old team imagery
// must stay marked off-site. A register that drifts from the logo/case-study
// models — or an asset with people or confidential UI left visible — fails here.
assertAssetRegisterValid();

// Engagement-model gate (§11.7 R-012): the "How we work" and "We're different"
// copy makes the site's most legally sensitive promises (unpaid preparation,
// gain-share, embedded delivery, clean exit). The documented engagement model
// must be complete and none of the §11.7-prohibited wording (an employment
// relationship, a guaranteed result, a universal payment claim, a mandatory
// sale, a fiduciary/agency/directorship representation, or a guaranteed back-end
// instrument) may reach that copy, or the build fails here.
assertEngagementModelValid();

// Conversion gate (§13, §20.3, D-006): the single site-wide CTA must never ship
// a wrong action. A configured booking URL that is insecure or off a Calendly
// host fails the build here; an unset URL (env-less local/preview build) only
// warns, since the deploy environment injects PUBLIC_CALENDLY_URL.
assertConfiguredCtaValid();
if (!isCtaConfigured()) {
  console.warn(
    "CTA: PUBLIC_CALENDLY_URL is not set — the primary conversion action will render without a booking link. Set it before deploying.",
  );
}
---

<BaseLayout title="Helix Collective — Enterprise Value Growth Partner">
  <Header slot="header" />
  <Hero />
  <ProofBanner />
  <LogoMarquee />
  <CaseStudies />
  <WhyHelix />
  <HowWeWork />
  <Fit />
  <FinalCta />
  <Footer slot="footer" />
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import ProofBanner from "../components/ProofBanner.astro";
import LogoMarquee from "../components/LogoMarquee.astro";
import CaseStudies from "../components/CaseStudies.astro";
import WhyHelix from "../components/WhyHelix.astro";
import HowWeWork from "../components/HowWeWork.astro";
import Fit from "../components/Fit.astro";
import FinalCta from "../components/FinalCta.astro";
import Footer from "../components/Footer.astro";
import { assertConfiguredCtaValid, isCtaConfigured } from "../config/cta";
import { assertPerformanceBudgetValid } from "../config/performanceBudget";

// Conversion gate (§13, §20.3): the single site-wide CTA must never ship a wrong
// action. A configured booking URL that is insecure or off a Calendly host fails
// the build here; an unset URL (env-less local/preview build) only warns, since
// the deploy environment injects PUBLIC_CALENDLY_URL.
assertConfiguredCtaValid();

// Performance-budget gate (§7 P7-006): the release budget — the Lighthouse
// category minimums, the Core Web Vitals ceilings (LCP/CLS/INP), and the
// initial-JavaScript ceiling — must stay internally coherent, or a Lighthouse
// run in CI would be checked against nonsense (a score outside 0–100, a
// non-positive ceiling, a dropped target). The Lighthouse scores themselves are
// measured in CI; the *rendered-output* invariants the budget depends on (no
// third-party embed on initial load, hydrate only the fit qualifier, and defer
// that island) are gated over the assembled page in renderedPerformance.test.ts.
assertPerformanceBudgetValid();

if (!isCtaConfigured()) {
  console.warn(
    "CTA: PUBLIC_CALENDLY_URL is not set — the primary conversion action will render without a booking link. Set it before deploying.",
  );
}
---

<BaseLayout title="Helix Collective — Enterprise Value Growth Partner">
  <Header slot="header" />
  <Hero />
  <ProofBanner />
  <LogoMarquee />
  <WhyHelix />
  <HowWeWork />
  <CaseStudies />
  <Fit />
  <FinalCta />
  <Footer slot="footer" />
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import ProofBanner from "../components/ProofBanner.astro";
import LogoMarquee from "../components/LogoMarquee.astro";
import CaseStudies from "../components/CaseStudies.astro";
import WhyHelix from "../components/WhyHelix.astro";
import HowWeWork from "../components/HowWeWork.astro";
import Fit from "../components/Fit.astro";
import FinalCta from "../components/FinalCta.astro";
import Footer from "../components/Footer.astro";
import {
  assertApprovalQueueValid,
  formatOpenQueueWarning,
} from "../config/approvalQueue";
import { assertClaimsLedgerValid } from "../config/claimsLedger";
import { assertClaimsMethodologyValid } from "../config/claimsMethodology";
import { assertAssetRegisterValid } from "../config/assetRegister";
import { assertCaseStudyDossiersValid } from "../config/caseStudyDossiers";
import { assertEngagementModelValid } from "../config/engagementModel";
import { assertDecisionsValid, formatOpenDecisionsWarning } from "../config/decisions";
import { assertAnalyticsAndPrivacyValid } from "../config/analyticsAndPrivacy";
import { assertConversionSpecValid } from "../config/conversionSpec";
import { assertSeoAndRedirectAuditValid } from "../config/seoAndRedirectAudit";
import { assertConfiguredCtaValid, isCtaConfigured } from "../config/cta";

// Governance gate (§23, P6-002): the queue must be internally consistent and
// must track every content item that still needs sign-off, or the build fails.
// Approval never blocks publication, so the still-open items are only surfaced
// as a non-fatal warning listing what publishes in draft form (§20.1).
assertApprovalQueueValid();
console.warn(formatOpenQueueWarning());

// Claims gate (§17.7 R-006, §20.1): every quantified claim on the site must
// resolve to a ledger entry that is not `rejected`, is backed by an open
// category-B approval item until it clears, and whose queue item actually covers
// it. A dangling or mismatched `claimIds` reference fails the build here.
assertClaimsLedgerValid();

// Claims-methodology gate (§17.6 R-005): the methodology that defines what every
// quantified claim *means* — enterprise value, attribution, currency, the
// valuation-date convention, multiples, debt/funding treatment, headline
// inclusion, double-counting, and the minimum evidence to publish — must be
// complete, link the §6 ambiguities it resolves (D-001/D-002/D-003) to real
// decisions, and define every metric type the ledger asserts. A ledger metric
// type with no methodology basis, or a dangling decision link, fails here.
assertClaimsMethodologyValid();

// Asset-rights gate (§17.9 R-008, §8.4, §16.5): every logo and case-study image
// the site can ship must resolve to an asset-register row recording its rights,
// and the removed brands, the Xylo case-study panel, and the old team imagery
// must stay marked off-site. A register that drifts from the logo/case-study
// models — or an asset with people or confidential UI left visible — fails here.
assertAssetRegisterValid();

// Case-study dossier gate (§17.8 R-007): each of the five case studies must have
// a research dossier under docs/research/case-studies/ capturing its engagement
// timeline, starting/end/current states, what Helix actually did, the valuation
// evidence, the calculation, the attribution language, sources, and asset/client
// approval position. §17.8 states "dependent copy may not be finalised until the
// corresponding dossier exists", so a required study with no dossier — or a
// published study whose dossier is missing — fails the build here.
assertCaseStudyDossiersValid();

// Engagement-model gate (§11.7 R-012): the "How we work" and "We're different"
// copy makes the site's most legally sensitive promises (unpaid preparation,
// gain-share, embedded delivery, clean exit). The documented engagement model
// must be complete and none of the §11.7-prohibited wording (an employment
// relationship, a guaranteed result, a universal payment claim, a mandatory
// sale, a fiduciary/agency/directorship representation, or a guaranteed back-end
// instrument) may reach that copy, or the build fails here.
assertEngagementModelValid();

// Decisions gate (§6, §2): the twelve open decisions (D-001..D-012) that gate
// published copy each live in the validated register. A dropped decision, a
// dangling approval-queue reference, or a content gate (the proof-banner
// currency, the hero performance-linked claim, the engagement-model review)
// marked approved without a recorded owner decision fails the build here. Like
// the approval queue, the still-open decisions are surfaced only as a non-fatal
// warning listing what publishes to its recommended default.
assertDecisionsValid();
console.warn(formatOpenDecisionsWarning());

// Analytics/privacy gate (§17.12 R-011, D-011): the funnel's "events to track"
// documentation must be exactly the no-op adapter's live ANALYTICS_EVENTS enum,
// every provider-contingent topic must link the real D-011 decision, and the
// record may not claim sign-off ahead of that decision. A new analytics event
// with no R-011 documentation — or a documented event the adapter dropped —
// fails the build here, keeping the measured surface auditable and PII-free.
assertAnalyticsAndPrivacyValid();

// Conversion-spec gate (§17.10 R-009, §13, §20.3, D-006): the R-009 record that
// documents the single booking action — the CTA label, the one conversion event,
// the approved Calendly hosts, same-tab behaviour, UTM/confirmation/notification
// handling, and the footer email fallback — must stay in lock-step with the live
// cta.ts config and analytics adapter. A documented label/event/host that has
// drifted from the code, a dangling D-006 link, an unapproved footer email, or a
// record claiming sign-off ahead of D-006 fails the build here.
assertConversionSpecValid();

// SEO/redirect audit gate (§17.11 R-010, P7-001/002/003/004, P7-009): the R-010
// record that audits the whole SEO surface — every indexable route, the
// canonical domain, the default title/description, the sitemap/robots rules, the
// conservative JSON-LD, the social-preview position, and the launch redirects —
// must stay in lock-step with the live siteMeta/sitemap/redirects config. A
// documented canonical origin, title, description, indexable-route set, or
// sitemap URL that has drifted from the code, a launch redirect missing from
// redirects.ts, forbidden schema markup, or a record claiming sign-off ahead of
// the standing launch review fails the build here.
assertSeoAndRedirectAuditValid();

// Conversion gate (§13, §20.3, D-006): the single site-wide CTA must never ship
// a wrong action. A configured booking URL that is insecure or off a Calendly
// host fails the build here; an unset URL (env-less local/preview build) only
// warns, since the deploy environment injects PUBLIC_CALENDLY_URL.
assertConfiguredCtaValid();
if (!isCtaConfigured()) {
  console.warn(
    "CTA: PUBLIC_CALENDLY_URL is not set — the primary conversion action will render without a booking link. Set it before deploying.",
  );
}
---

<BaseLayout title="Helix Collective — Enterprise Value Growth Partner">
  <Header slot="header" />
  <Hero />
  <ProofBanner />
  <LogoMarquee />
  <CaseStudies />
  <WhyHelix />
  <HowWeWork />
  <Fit />
  <FinalCta />
  <Footer slot="footer" />
</BaseLayout>

---
import "../styles/global.css";
import {
  DEFAULT_DESCRIPTION,
  DEFAULT_TITLE,
  SITE_LOCALE,
  ORGANIZATION_NAME,
  canonicalUrl,
  structuredDataGraph,
  assertStructuredDataValid,
  assertPageMetaValid,
} from "../config/siteMeta";
import {
  OG_IMAGE_PATH,
  OG_IMAGE_WIDTH,
  OG_IMAGE_HEIGHT,
  OG_IMAGE_TYPE,
  OG_IMAGE_ALT,
  assertSocialCardValid,
} from "../config/socialCard";

export interface Props {
  title?: string;
  description?: string;
  /** Root-relative path of this page, used for the canonical URL. */
  canonicalPath?: string;
  /** Ask search engines not to index this page (e.g. the 404 page). */
  noindex?: boolean;
}

const {
  title = DEFAULT_TITLE,
  description = DEFAULT_DESCRIPTION,
  canonicalPath = "/",
  noindex = false,
} = Astro.props;

// Fail the build on placeholder copy or an off-root canonical path rather than
// shipping broken metadata (P7-001/P7-002).
assertPageMetaValid({ title, description, canonicalPath });

const canonical = canonicalUrl(canonicalPath);

// The social-preview card ships in its safe brand-only draft form (P7-003); its
// final designed artwork is signed off through the standing launch review
// (Q-0009). Fail the build if the card ever carries a figure, a person, or
// off-brand copy.
assertSocialCardValid();
const ogImage = canonicalUrl(OG_IMAGE_PATH);

// Indexable pages carry the site's structured data; the 404 page does not
// (P7-004). Validate it so a forbidden node never reaches the markup.
const structuredData = noindex ? null : structuredDataGraph();
if (structuredData) assertStructuredDataValid(structuredData);

const gaMeasurementId = (import.meta.env.PUBLIC_GA_MEASUREMENT_ID as string | undefined)
  ?.trim();
const cloudflareAnalyticsToken = (
  import.meta.env.PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN as string | undefined
)?.trim();
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <link rel="canonical" href={canonical} />
    )}

    <!-- Open Graph (P7-003 card publishes in draft; final artwork via Q-0009). -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={ORGANIZATION_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={SITE_LOCALE} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content={OG_IMAGE_TYPE} />
    <meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />
    <meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />
    <meta property="og:image:alt" content={OG_IMAGE_ALT} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Self-hosted brand fonts (P3-003, D-010): preload only the critical weights. -->
    <link rel="preload" href="/fonts/oswald-700-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/roboto-variable-latin.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    {gaMeasurementId && (
      <>
        <script
          is:inline
          async
          src={`https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(
            gaMeasurementId,
          )}`}
        />
        <script
          is:inline
          set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag("js",new Date());gtag("config",${JSON.stringify(
            gaMeasurementId,
          )});`}
        />
      </>
    )}
    {structuredData && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(structuredData)}
      />
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot name="header" />
    <main id="main">
      <slot />
    </main>
    <slot name="footer" />

    {/* One delegated listener tracks every `cta_click` (P5-006, D-006 outbound
        tracking). GA4 receives explicit funnel events when configured; otherwise
        the listener remains no-op-safe. */}
    <script>
      import { configureGoogleAnalytics, trackAnalyticsClicks } from "../utils/analytics";
      configureGoogleAnalytics();
      trackAnalyticsClicks();
    </script>
    {cloudflareAnalyticsToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: cloudflareAnalyticsToken })}
      />
    )}
  </body>
</html>

---
/**
 * Homepage proof banner (implementation plan §8.3 Proof banner, Phase 4 step 3).
 *
 * A deliberately narrow two-column proof strip — `$500M+` enterprise value
 * created and `10+` years in operation — and nothing else. Structure and copy
 * come from the validated `proofBanner` content model; this component invents no
 * metrics of its own, so the removed `50+ ventures` count, any human/team count,
 * or a vanity metric bolted on to refill the old four-column layout cannot creep
 * back in through markup.
 *
 * `assertProofBannerValid()` runs at render time so a drifted banner fails the
 * build instead of shipping. The banner publishes in its safe, currency-neutral
 * draft form: the `$500M+` figure uses a bare `$` while the D-001 currency
 * decision is tracked asynchronously by the open queue item Q-0007 (§23).
 * `publishedProofBanner()` returns `null` only if the model is explicitly held
 * back (`publish: false`), in which case this component renders nothing.
 */
import {
  proofBanner as defaultBanner,
  publishedProofBanner,
  assertProofBannerValid,
  type ProofBanner,
} from "../config/proofBanner";

export interface Props {
  /** Defaults to the site's `proofBanner` model; overridable for testing. */
  banner?: ProofBanner;
}

const { banner = defaultBanner } = Astro.props;

assertProofBannerValid(banner);

const published = publishedProofBanner(banner);
---

{
  published && (
    <section class="proof" aria-labelledby="proof-heading">
      <h2 class="proof__heading" id="proof-heading">
        Proof
      </h2>
      <dl class="proof__list section-shell">
        {published.metrics.map((metric) => (
          <div class="proof__metric metric">
            <dt class="metric__value">{metric.value}</dt>
            <dd class="metric__label">{metric.label}</dd>
          </div>
        ))}
      </dl>
    </section>
  )
}

<style>
  /* Black-on-mint proof strip (VD-102). The 2026-07-29 live-site audit
     (currentSiteAudit.ts, R-001) records the proof strip as one of the site's
     full-bleed mint section backgrounds carrying black text; the strip is the
     homepage's single mint surface, so the accent lands here as a full-bleed
     block rather than as a hairline accent. Mint is a surface colour, not a text
     colour — ink-on-mint clears WCAG AA where mint-on-white fails it (§16.2) —
     so the text is pinned to ink and the pairing's contrast is asserted in
     proofBannerSurface.test.ts. The full-bleed colour change delineates the
     strip from the white sections above and below, so no hairline border is
     needed. */
  .proof {
    background-color: var(--color-accent);
    color: var(--color-helix-ink);
  }

  /* The banner is a proof strip, not a titled section; the heading names the
     landmark for assistive tech without competing with the metrics visually. */
  .proof__heading {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .proof__list {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    padding-block: var(--space-12);
  }

  /* Two equal columns from the small-tablet breakpoint up; stacked with equal
     visual weight below it (§8.3). */
  @media (min-width: 40rem) {
    .proof__list {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

---
/**
 * Homepage proof banner (implementation plan §8.3 Proof banner, Phase 4 step 3).
 *
 * A deliberately narrow two-column proof strip — `$500M+` enterprise value
 * created and `10+` years in operation — and nothing else. Structure and copy
 * come from the validated `proofBanner` content model; this component invents no
 * metrics of its own, so the removed `50+ ventures` count, any human/team count,
 * or a vanity metric bolted on to refill the old four-column layout cannot creep
 * back in through markup.
 *
 * `assertProofBannerValid()` runs at render time so a drifted banner fails the
 * build instead of shipping. The `$500M+` figure uses a bare `$`, and that
 * currency-neutral wording is the approved one: Q-0007 signed it off on
 * 2026-07-29 and the D-001 currency decision is decided (§23), so
 * `currencyApproval` is `"approved"`. `publishedProofBanner()` returns `null`
 * only if the model is explicitly held back (`publish: false`), in which case
 * this component renders nothing.
 */
import {
  proofBanner as defaultBanner,
  publishedProofBanner,
  assertProofBannerValid,
  type ProofBanner,
} from "../config/proofBanner";

export interface Props {
  /** Defaults to the site's `proofBanner` model; overridable for testing. */
  banner?: ProofBanner;
}

const { banner = defaultBanner } = Astro.props;

assertProofBannerValid(banner);

const published = publishedProofBanner(banner);
---

{
  published && (
    <section class="proof" aria-labelledby="proof-heading">
      <h2 class="proof__heading" id="proof-heading">
        Proof
      </h2>
      <dl class="proof__list">
        {published.metrics.map((metric) => (
          <div class="proof__metric metric">
            <dt class="metric__value">{metric.value}</dt>
            <dd class="metric__label">{metric.label}</dd>
          </div>
        ))}
      </dl>
    </section>
  )
}

<style>
  /* Black-on-mint proof strip (VD-102). The 2026-07-29 live-site audit
     (currentSiteAudit.ts, R-001) records the proof strip as one of the site's
     full-bleed mint section backgrounds carrying black text; the strip is one
     of them (the case-studies band is another, gated by casesSurface.test.ts),
     so the accent lands here as a full-bleed block rather than as a hairline
     accent. Mint is a surface colour, not a text
     colour — ink-on-mint clears WCAG AA where mint-on-white fails it (§16.2) —
     so the text is pinned to ink and the pairing's contrast is asserted in
     proofBannerSurface.test.ts.

     The live site rules the strip in thin black: a hairline above and below the
     band, and a hairline between the metric cells, so the figures read as a row
     of framed panels rather than as floating text on mint (RW-002 desktop
     screenshot). The bottom rule is also the line between this strip and the
     logo ticker below it, which is why the marquee draws only its own bottom
     edge — two adjacent 1px borders would render as a 2px rule the live site
     does not have. */
  .proof {
    background-color: var(--color-accent);
    color: var(--color-helix-ink);
    border-block: 1px solid var(--color-helix-ink);
  }

  /* The banner is a proof strip, not a titled section; the heading names the
     landmark for assistive tech without competing with the metrics visually. */
  .proof__heading {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* The strip is the one section that deliberately does *not* frame its content
     with the shared `.section-shell` (VD-104): the shell caps content at
     --width-container and centres it, which left each metric centred on its half
     of the *container* while the band's rules run to the viewport edge — so both
     callouts sat pulled toward the middle of the band, off the centre of the cell
     they are ruled into. Full-bleed cells put each figure on the centre of its
     own bordered half, which is what the live site does (RW-002). The gutter and
     the vertical rhythm ride the cells so the divider runs the band's full
     height. */
  .proof__list {
    display: grid;
    grid-template-columns: 1fr;
  }

  .proof__metric {
    padding: var(--space-12) var(--space-6);
  }

  /* Stacked below the breakpoint, so the divider is horizontal. */
  .proof__metric + .proof__metric {
    border-block-start: 1px solid var(--color-helix-ink);
  }

  /* Two equal columns from the small-tablet breakpoint up; stacked with equal
     visual weight below it (§8.3). */
  @media (min-width: 40rem) {
    .proof__list {
      grid-template-columns: 1fr 1fr;
    }

    .proof__metric {
      padding-inline: var(--space-8);
    }

    .proof__metric + .proof__metric {
      border-block-start: 0;
      border-inline-start: 1px solid var(--color-helix-ink);
    }
  }
</style>

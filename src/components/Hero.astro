---
/**
 * Homepage hero (implementation plan §8.2 Hero, Phase 4).
 *
 * The hero carries the site's single most important statement, so — like the
 * header — it invents nothing: eyebrow, headline, supporting copy and CTA all
 * come from the validated `hero` content model and the single `primaryCta`
 * config. `assertHeroValid()` runs at render time so a softened headline, an
 * off-label CTA, or an unconfirmed D-009 performance-linked claim fails the
 * build instead of shipping.
 */
import { hero, heroSupportingCopy, assertHeroValid } from "../config/hero";
import { primaryCta } from "../config/cta";

assertHeroValid(hero);

const { eyebrow, headline, supportingLine, ctaLabel } = hero;
const supportingCopy = heroSupportingCopy(hero);
---

<section class="hero" id="top" aria-labelledby="hero-headline">
  <div class="hero__inner section-shell">
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="hero__headline" id="hero-headline">{headline}</h1>
    <p class="hero__supporting">{supportingCopy}</p>
    {supportingLine && <p class="hero__line">{supportingLine}</p>}
    <a
      class="hero__cta cta-button"
      href={primaryCta.href}
      data-analytics-event={primaryCta.analyticsEvent}>{ctaLabel}</a
    >
  </div>
</section>

<style>
  /* White-on-black hero (VD-102). The 2026-07-29 live-site audit
     (currentSiteAudit.ts, R-001) records the hero as running white-on-black —
     pure black `#000000`, the `--color-ink-900` token. The hero carries the
     site's single most important statement, so it leads as a full-bleed black
     surface rather than the default white body, mirroring the live site's
     confident, high-impact opening. White-on-black clears WCAG AA at the maximum
     21:1 ratio (§16.2), asserted in heroSurface.test.ts. The full-bleed colour
     change delineates the hero from the mint proof strip directly below it, so
     no hairline border is needed. */
  .hero {
    background-color: var(--color-ink-900);
    color: var(--color-white);
  }

  .hero__inner {
    padding-block: var(--space-16);
  }

  .hero__headline {
    font-size: var(--font-size-h1);
    line-height: var(--line-height-display);
    margin: 0 0 var(--space-6);
    max-width: 20ch;
  }

  .hero__supporting {
    font-size: var(--font-size-lg);
    max-width: var(--width-text);
    margin: 0 0 var(--space-3);
  }

  .hero__line {
    max-width: var(--width-text);
    margin: 0 0 var(--space-8);
  }

  .hero__cta {
    display: inline-block;
    font-weight: var(--font-weight-bold);
    text-decoration: none;
    /* Wrap the long approved label instead of overflowing a 320 px viewport
       (FX-201). */
    overflow-wrap: break-word;
  }
</style>

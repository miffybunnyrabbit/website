---
/**
 * Homepage "Are we a fit?" qualifier section (implementation plan §12).
 *
 * The static framing (eyebrow, headline, intro) is plain Astro HTML from the
 * validated `fitSectionCopy`; only the qualifier itself is a React island,
 * hydrated with `client:visible` so the rest of the page ships no JavaScript
 * (§18.5). `assertFitSectionCopyValid()` and `assertFitFlowValid()` run at
 * render time, turning a blank/placeholder heading or a broken decision graph
 * into a build failure rather than a published mistake.
 *
 * A `<noscript>` block carries the full qualification summary and the single
 * CTA (§12.4): with JavaScript disabled the visitor still sees every question
 * and outcome and can reach the one conversion action. The interactive island
 * server-renders its first question, so there is a useful view before hydration
 * too. Connector styling is decorative, focus states are visible, no state is
 * communicated by colour alone, and `prefers-reduced-motion` is honoured.
 */
import {
  fitSectionCopy as defaultCopy,
  questionNodes,
  resultNodes,
  assertFitSectionCopyValid,
  assertFitFlowValid,
  type FitSectionCopy,
} from "./fit/fitFlow";
import { primaryCta } from "../config/cta";
import FitQualifier from "./fit/FitQualifier.tsx";

export interface Props {
  /** Defaults to the site's fit-section copy; overridable for testing. */
  copy?: FitSectionCopy;
}

const { copy = defaultCopy } = Astro.props;

assertFitSectionCopyValid(copy);
assertFitFlowValid();

const questions = questionNodes();
const results = resultNodes();
---

<section class="fit" aria-labelledby="fit-heading">
  <div class="fit__inner">
    <p class="fit__eyebrow">{copy.eyebrow}</p>
    <h2 class="fit__headline" id="fit-heading">{copy.headline}</h2>
    <p class="fit__intro">{copy.intro}</p>

    <FitQualifier client:visible />

    {/* Full qualification summary and CTA for visitors without JavaScript. */}
    <noscript>
      <div class="fit__fallback">
        <p class="fit__fallback-lead">
          The questions below map to five outcomes. Read the path that matches
          you, then book a conversation.
        </p>
        <ol class="fit__fallback-questions">
          {questions.map((q) => <li>{q.prompt}</li>)}
        </ol>
        <ul class="fit__fallback-outcomes" role="list">
          {
            results.map((r) => (
              <li class="fit__fallback-outcome">
                <h3 class="fit__fallback-headline">{r.headline}</h3>
                <p>{r.body}</p>
                {r.address && (
                  <address class="fit__fallback-address">{r.address}</address>
                )}
              </li>
            ))
          }
        </ul>
        <a
          class="fit__fallback-cta cta-button"
          href={primaryCta.href}
          data-analytics-event={primaryCta.analyticsEvent}>{primaryCta.label}</a
        >
      </div>
    </noscript>
  </div>
</section>

<style>
  .fit {
    border-bottom: 1px solid var(--color-ink-100);
  }

  .fit__inner {
    max-width: var(--width-container);
    margin-inline: auto;
    padding: var(--space-16) var(--space-6);
  }

  .fit__eyebrow {
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--letter-spacing-eyebrow);
    margin: 0 0 var(--space-4);
  }

  .fit__headline {
    font-size: var(--font-size-h2);
    line-height: 1.1;
    margin: 0 0 var(--space-6);
    max-width: 24ch;
  }

  .fit__intro {
    font-size: var(--font-size-lg);
    max-width: 56ch;
    margin: 0 0 var(--space-10);
  }

  .fit__fallback {
    margin-top: var(--space-8);
  }

  .fit__fallback-outcomes {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-6);
  }

  .fit__fallback-headline {
    margin: 0 0 var(--space-2);
  }

  .fit__fallback-cta {
    display: inline-block;
    margin-top: var(--space-6);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.04em;
    text-decoration: none;
  }
</style>

{/* Island children are not scoped by Astro, so the qualifier's styles are
    declared globally under the section class. All meaning survives without
    these rules; they add spacing, visible focus, and a restrained active cue. */}
<style is:global>
  .fit-qualifier {
    max-width: 40rem;
    border: 1px solid var(--color-ink-100);
    border-radius: 0.5rem;
    padding: var(--space-8) var(--space-6);
  }

  .fit-qualifier__progress {
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.8125rem;
    margin: 0 0 var(--space-4);
  }

  .fit-qualifier__question {
    border: 0;
    margin: 0;
    padding: 0;
  }

  .fit-qualifier__prompt {
    font-size: var(--font-size-xl);
    line-height: 1.3;
    padding: 0;
    margin: 0 0 var(--space-6);
    max-width: 40ch;
  }

  .fit-qualifier__answers {
    display: grid;
    gap: var(--space-3);
  }

  .fit-qualifier__answer {
    display: block;
    width: 100%;
    padding: var(--space-4);
    font-size: 1.0625rem;
    font-weight: var(--font-weight-bold);
    cursor: pointer;
    border: 2px solid currentColor;
    border-radius: var(--radius-sm);
    background: transparent;
  }

  .fit-qualifier__result-headline {
    font-size: 1.375rem;
    line-height: var(--line-height-heading);
    margin: 0 0 var(--space-3);
    max-width: 30ch;
  }

  .fit-qualifier__result-body {
    margin: 0 0 var(--space-6);
    max-width: var(--width-text);
  }

  .fit-qualifier__cta {
    display: inline-block;
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  .fit-qualifier__address {
    font-style: normal;
    margin-top: var(--space-2);
  }

  .fit-qualifier__controls {
    display: flex;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  .fit-qualifier__control {
    background: transparent;
    border: 0;
    padding: var(--space-2) 0;
    font-weight: var(--font-weight-bold);
    text-decoration: underline;
    cursor: pointer;
  }

  .fit-qualifier__control:disabled {
    opacity: 0.4;
    cursor: not-allowed;
    text-decoration: none;
  }

  /* Visible focus for every keyboard-operable control (§12.4). */
  .fit-qualifier :is(button, a):focus-visible {
    outline: 3px solid currentColor;
    outline-offset: 2px;
  }

  /* Restrained hover/active cue only; suppressed for reduced-motion (§12.4). */
  @media (prefers-reduced-motion: no-preference) {
    .fit-qualifier__answer {
      transition:
        background-color var(--duration-fast) var(--ease-standard),
        color var(--duration-fast) var(--ease-standard);
    }
  }
</style>

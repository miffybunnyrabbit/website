---
/**
 * Homepage closing call-to-action (implementation plan §13, Phase 4 item 8).
 *
 * The plan replaces the old "build something" / "invest in ventures" split with
 * one action, so this section renders exactly one headline, one supporting
 * line, and the single approved `primaryCta` button. The button reads its URL,
 * label, and analytics event from the central `primaryCta` config rather than
 * hardcoding them here (§13), so the whole site funnels to one conversion
 * event. `assertFinalCtaCopyValid()` runs at render time, turning a missing or
 * placeholder headline into a build failure rather than a published mistake.
 *
 * The section is static Astro HTML and CSS: no React and no client-side state,
 * so the conversion action works with JavaScript disabled. The CTA URL itself
 * is injected at build time via `PUBLIC_CALENDLY_URL`; the homepage build gate's
 * `assertConfiguredCtaValid()` fails the build if a configured URL is insecure
 * or off Calendly, so this button never renders a wrong booking link.
 */
import {
  primaryCta,
  finalCtaCopy as defaultCopy,
  assertFinalCtaCopyValid,
  type FinalCtaCopy,
} from "../config/cta";

export interface Props {
  /** Defaults to the site's closing-CTA copy; overridable for testing. */
  copy?: FinalCtaCopy;
}

const { copy = defaultCopy } = Astro.props;

assertFinalCtaCopyValid(copy);
---

<section class="final-cta" aria-labelledby="final-cta-heading">
  <div class="final-cta__inner">
    <h2 class="final-cta__headline" id="final-cta-heading">
      {copy.headline}
    </h2>
    <p class="final-cta__supporting">{copy.supportingLine}</p>
    <a
      class="final-cta__button cta-button"
      href={primaryCta.href}
      data-analytics-event={primaryCta.analyticsEvent}>{primaryCta.label}</a
    >
  </div>
</section>

<style>
  .final-cta {
    border-bottom: 1px solid var(--color-ink-100);
  }

  .final-cta__inner {
    max-width: var(--width-container);
    margin-inline: auto;
    padding: var(--space-16) var(--space-6);
    text-align: center;
  }

  .final-cta__headline {
    font-size: var(--font-size-h2);
    line-height: 1.1;
    margin: 0 auto var(--space-4);
    max-width: 24ch;
  }

  .final-cta__supporting {
    font-size: var(--font-size-lg);
    max-width: var(--width-text);
    margin: 0 auto var(--space-8);
  }

  .final-cta__button {
    display: inline-block;
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--letter-spacing-action);
    text-decoration: none;
    /* Wrap the long approved label instead of overflowing a 320 px viewport
       (FX-201). */
    overflow-wrap: break-word;
  }
</style>
